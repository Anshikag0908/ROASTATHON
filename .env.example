# ==========================================
# mcpguard environment configuration
# NOTE: Never store real secrets or API keys in this template file.
# Copy this file to .env and provide your values.
# ==========================================

# ------------------------------------------
# LLM Triage Configuration
# ------------------------------------------
# Provider selection (e.g., gemini, openai, anthropic)
MCPGUARD_LLM_PROVIDER=

# Model identifier (e.g., gemini-1.5-pro, gpt-4o, claude-3-5-sonnet-20241022)
MCPGUARD_LLM_MODEL=

# API keys (leave blank if running with --no-llm)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Max tokens / budget cap per scan triage
MCPGUARD_LLM_MAX_TOKENS=

# ------------------------------------------
# Sandbox & Container Configuration
# ------------------------------------------
# Overall sandbox execution timeout in milliseconds
MCPGUARD_SANDBOX_TIMEOUT_MS=

# Timeout per individual tool call in milliseconds
MCPGUARD_TOOL_TIMEOUT_MS=

# Container resource limits
MCPGUARD_SANDBOX_CPU_LIMIT=
MCPGUARD_SANDBOX_MEMORY_LIMIT=
MCPGUARD_SANDBOX_PID_LIMIT=

# Sandbox base image names
MCPGUARD_SANDBOX_IMAGE=
MCPGUARD_SINK_IMAGE=

# Comma-separated list of allowlisted domains for target network egress (if any)
MCPGUARD_NETWORK_ALLOWLIST=

# ------------------------------------------
# Logging & Reporting
# ------------------------------------------
# Log verbosity (debug, info, warn, error)
MCPGUARD_LOG_LEVEL=

# Dashboard server port (for live report / web view, Phase 7)
MCPGUARD_DASHBOARD_PORT=
